# Development only. Use secret manager / mounted secret files in deployments.
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATABASE_URL=postgres://inwp_api:replace-me@127.0.0.1:5432/inwp?application_name=inwp-workforce-api
OIDC_ISSUER=https://identity.example.invalid/realms/inwp
OIDC_AUDIENCE=inwp-workforce-api
OIDC_JWKS_URL=https://identity.example.invalid/realms/inwp/protocol/openid-connect/certs
PUBLIC_ORIGIN=http://127.0.0.1:3000
SESSION_COOKIE_NAME=inwp_access_dev
DB_POOL_MAX=10

# Production-only; inject through a secret manager, never commit real values.
# NODE_ENV=production
# DB_CA_PEM=<mounted trusted CA contents>
# TLS_CERT_FILE=/run/secrets/api.crt
# TLS_KEY_FILE=/run/secrets/api.key
